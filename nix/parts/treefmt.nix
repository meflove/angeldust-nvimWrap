{inputs, ...}: {
  flake-file.inputs = {
    treefmt-nix.url = "github:numtide/treefmt-nix";
    treefmt.url = "github:numtide/treefmt-nix";
  };
  imports = [
    inputs.treefmt-nix.flakeModule
  ];

  perSystem = {
    config,
    lib,
    pkgs,
    ...
  }: {
    checks.formatting = config.checks.treefmt;

    treefmt = {
      imports = [
        inputs.pedantix.treefmtModules.default
      ];

      settings = {
        global = {
          on-unmatched = "warn";
          excludes = [
            ".gitignore"
            ".envrc"
            # generated by flake-file (formatted by its own formatter)
            "flake.nix"
          ];
        };
        formatter = {
          emmylua = let
            luafmt = lib.getExe' pkgs.emmylua_formatter "luafmt";
          in {
            command = lib.getExe pkgs.bash;
            includes = ["*.lua"];
            options = [
              "-euc"
              ''
                for file in "$@"; do
                  ${luafmt} --write "$file"
                done
              ''
              "--"
            ];
          };
        };
      };
      programs = {
        # nix
        alejandra = {
          enable = true;
          priority = 1;
          includes = [
            "*.nix"
          ];
        };

        pedantix = {
          enable = true;
          priority = 2;
          includes = [
            "*.nix"
          ];
          settings = {
            preset = "nixos-module";
            formatter = "alejandra";
            on-parse-error = "skip";

            args = {
              sort = true;
            };
            attrs = {
              sort = false;
            };
            inherits = {
              sort = false;
            };
            lets = {
              sort = false;
            };
          };
        };

        statix = {
          enable = true;
          priority = 3;
          includes = [
            "*.nix"
          ];
        };

        deadnix = {
          enable = true;
          priority = 4;
          includes = [
            "*.nix"
          ];

          no-underscore = true;
        };

        # md
        prettier = {
          enable = true;
          includes = [
            "*.md"
          ];
        };

        # json
        jsonfmt = {
          enable = true;
          includes = [
            "*.json"
            "*.jsonc"
          ];
        };

        # toml
        taplo = {
          enable = true;
          includes = [
            "*.toml"
          ];
        };

        # yaml
        yamlfmt = {
          enable = true;
          includes = [
            "*.yaml"
            "*.yml"
          ];

          settings = {
            formatter = {
              include_document_start = true;
            };
          };
        };
      };
    };
  };
}
